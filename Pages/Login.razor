@page "/login"
@layout EmptyLayout
@inject NavigationManager Navigation

<AuthLayout RightTitle="Welcome back" RightSubtitle="Your schedule is waiting for you">
    <div class="w-full max-w-[360px]">
        <h2 class="text-[1.75rem] font-semibold tracking-tight text-gray-50 mb-1.5">Sign in</h2>
        <p class="text-sm text-gray-500 mb-8">
            Don't have an account?
            <a href="/register" class="text-[#2dd4bf] font-medium hover:text-[#5eead4] transition-colors">Register here</a>
        </p>

        <EditForm Model="@model" OnSubmit="HandleLogin" class="space-y-5">

            @if (!string.IsNullOrEmpty(serverError))
            {
                <div class="rounded-lg border border-rose-500/30 bg-rose-500/10 px-3.5 py-2.5 text-xs text-rose-400">
                    @serverError
                </div>
            }

            <div>
                <label for="login-email" class="block text-xs font-medium text-gray-500 mb-1.5">Email</label>
                <div class="flex items-center gap-2.5 rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2.5 focus-within:border-[#2dd4bf]/50 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" />
                    </svg>
                    <InputText id="login-email" @bind-Value="model.Email" placeholder="Enter your email"
                               autocomplete="email"
                               class="border-0 outline-none flex-1 text-sm bg-transparent text-gray-100 placeholder:text-gray-600" />
                </div>
            </div>

            <div>
                <label for="login-password" class="block text-xs font-medium text-gray-500 mb-1.5">Password</label>
                <div class="flex items-center gap-2.5 rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2.5 focus-within:border-[#2dd4bf]/50 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <InputText id="login-password" type="@(showPassword ? "text" : "password")"
                               @bind-Value="model.Password" placeholder="Enter your password"
                               autocomplete="current-password"
                               class="border-0 outline-none flex-1 text-sm bg-transparent text-gray-100 placeholder:text-gray-600" />
                    <button type="button" @onclick="() => showPassword = !showPassword"
                            aria-label="@(showPassword ? "Hide password" : "Show password")"
                            class="shrink-0 text-gray-500 hover:text-gray-300 transition-colors">
                        @if (showPassword)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a21.8 21.8 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <div class="flex justify-between items-center text-xs text-gray-500 !mt-4">
                <label class="flex items-center gap-1.5 cursor-pointer">
                    <input type="checkbox" @bind="model.RememberMe" class="accent-[#14b8a6]" /> Remember me
                </label>
                <a href="/forgot-password" class="text-[#2dd4bf] hover:text-[#5eead4] transition-colors">Forgot password?</a>
            </div>

            <button type="submit" disabled="@isSubmitting"
                    class="w-full py-2.5 rounded-lg border-0 bg-[#14b8a6] hover:bg-[#2dd4bf] disabled:bg-[#14b8a6]/50 disabled:cursor-not-allowed text-[#04211d] text-sm font-semibold cursor-pointer transition-colors !mt-6 flex items-center justify-center gap-2">
                @if (isSubmitting)
                {
                    <svg class="w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.37 0 0 5.37 0 12h4Z"></path>
                    </svg>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </EditForm>

        <div class="flex items-center gap-3 my-6">
            <div class="h-px flex-1 bg-white/10"></div>
            <span class="text-xs text-gray-500">or continue with</span>
            <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <div class="flex justify-center gap-3">
            <button type="button" @onclick="HandleFacebookLogin" disabled="@isSubmitting"
                    class="flex-1 flex items-center justify-center border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-white/20 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg py-2.5 cursor-pointer transition-colors">
                <img src="images/facebook-logo.svg" alt="Facebook" class="h-5 w-auto max-w-5 object-contain" />
            </button>
            <button type="button" @onclick="HandleGoogleLogin" disabled="@isSubmitting"
                    class="flex-1 flex items-center justify-center border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-white/20 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg py-2.5 cursor-pointer transition-colors">
                <img src="images/google-logo.svg" alt="Google" class="h-5 w-auto max-w-5 object-contain" />
            </button>
            <button type="button" @onclick="HandleAppleLogin" disabled="@isSubmitting"
                    class="flex-1 flex items-center justify-center border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-white/20 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg py-2.5 cursor-pointer transition-colors">
                <img src="images/apple-logo.svg" alt="Apple" class="h-5 w-auto max-w-5 object-contain" />
            </button>
        </div>
    </div>
</AuthLayout>

@code {
    private LoginModel model = new();
    private bool showPassword = false;
    private bool isSubmitting = false;
    private string? serverError;

    private async Task HandleLogin()
    {
        serverError = null;
        isSubmitting = true;
        try
        {
            // TODO: validate credentials against backend before navigating
            await Task.Delay(600);
            Navigation.NavigateTo("/home");
        }
        catch (Exception)
        {
            serverError = "Invalid email or password. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleFacebookLogin()
    {
        isSubmitting = true;
        // TODO: wire up Facebook OAuth
        await Task.Delay(400);
        Navigation.NavigateTo("/home");
    }

    private async Task HandleGoogleLogin()
    {
        isSubmitting = true;
        // TODO: wire up Google OAuth
        await Task.Delay(400);
        Navigation.NavigateTo("/home");
    }

    private async Task HandleAppleLogin()
    {
        isSubmitting = true;
        // TODO: wire up Apple OAuth
        await Task.Delay(400);
        Navigation.NavigateTo("/home");
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";

        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
