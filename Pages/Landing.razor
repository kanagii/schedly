@page "/"
@layout EmptyLayout
@inject NavigationManager Navigation

<div class="min-h-screen bg-[#0b0d11] text-gray-200 font-sans">

    <header class="sticky top-0 z-30 border-b border-white/[0.06] bg-[#0b0d11]/80 backdrop-blur">
        <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg bg-[#14b8a6]/10 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <span class="text-sm font-semibold tracking-tight text-gray-50">Schedly</span>
            </div>

            <div class="flex items-center gap-2">
                <a href="/login" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-gray-100 transition-colors">Sign in</a>
                <a href="/register" class="px-4 py-2 rounded-lg text-sm font-semibold bg-[#14b8a6] hover:bg-[#2dd4bf] text-[#04211d] transition-colors">Get started</a>
            </div>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="relative overflow-hidden">
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full bg-[#14b8a6]/10 blur-3xl"></div>
            </div>

            <div class="relative max-w-3xl mx-auto px-6 pt-24 pb-16 text-center">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.08] bg-white/[0.03] text-xs text-gray-400 mb-6">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf]"></span>
                    Built for students who double-book everything
                </div>

                <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-gray-50 leading-tight">
                    Plan your day,<br class="hidden sm:block" /> your way
                </h1>
                <p class="mt-5 text-base text-gray-500 max-w-lg mx-auto">
                    Schedly keeps classes, deadlines, and focus time in one clean timeline — so nothing slips through the cracks.
                </p>

                <div class="mt-8 flex items-center justify-center gap-3">
                    <a href="/register" class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-[#14b8a6] hover:bg-[#2dd4bf] text-[#04211d] transition-colors">
                        Get started free
                    </a>
                    <a href="/login" class="px-5 py-2.5 rounded-lg text-sm font-medium border border-white/[0.08] text-gray-300 hover:bg-white/[0.03] transition-colors">
                        Sign in
                    </a>
                </div>
            </div>

            <!-- Decorative mini product preview -->
            <div class="relative max-w-3xl mx-auto px-6 pb-24">
                <div class="rounded-xl border border-white/[0.08] bg-[#0e1013] shadow-2xl shadow-black/40 overflow-hidden">
                    <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/[0.06]">
                        <span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
                    </div>
                    <div class="p-5 space-y-2.5">
                        <div class="flex items-center gap-3 rounded-lg border-l-2 border-blue-500 bg-blue-500/[0.07] px-3.5 py-2.5">
                            <span class="text-[0.7rem] text-gray-500 w-12 shrink-0">09:00</span>
                            <span class="text-sm font-medium text-gray-100">Morning standup</span>
                        </div>
                        <div class="flex items-center gap-3 rounded-lg border-l-2 border-violet-400 bg-violet-400/[0.07] px-3.5 py-2.5">
                            <span class="text-[0.7rem] text-gray-500 w-12 shrink-0">09:30</span>
                            <span class="text-sm font-medium text-gray-100">Deep work: thesis draft</span>
                        </div>
                        <div class="flex items-center gap-3 rounded-lg border-l-2 border-green-500 bg-green-500/[0.07] px-3.5 py-2.5">
                            <span class="text-[0.7rem] text-gray-500 w-12 shrink-0">12:00</span>
                            <span class="text-sm font-medium text-gray-100">Lunch</span>
                        </div>
                        <div class="flex items-center gap-3 rounded-lg border-l-2 border-pink-500 bg-pink-500/[0.07] px-3.5 py-2.5">
                            <span class="text-[0.7rem] text-gray-500 w-12 shrink-0">17:30</span>
                            <span class="text-sm font-medium text-gray-100">Gym</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features -->
        <section class="border-t border-white/[0.06]">
            <div class="max-w-5xl mx-auto px-6 py-20">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

                    <div class="rounded-xl border border-white/[0.06] bg-[#0e1013] p-6">
                        <div class="w-9 h-9 rounded-lg bg-[#14b8a6]/10 flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-[1.125rem] h-[1.125rem] text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-100 mb-1.5">Daily timeline</h3>
                        <p class="text-sm text-gray-500 leading-relaxed">See exactly what's next with an hour-by-hour view of your day.</p>
                    </div>

                    <div class="rounded-xl border border-white/[0.06] bg-[#0e1013] p-6">
                        <div class="w-9 h-9 rounded-lg bg-[#14b8a6]/10 flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-[1.125rem] h-[1.125rem] text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-100 mb-1.5">Week at a glance</h3>
                        <p class="text-sm text-gray-500 leading-relaxed">Zoom out to spot free blocks and conflicts before they happen.</p>
                    </div>

                    <div class="rounded-xl border border-white/[0.06] bg-[#0e1013] p-6">
                        <div class="w-9 h-9 rounded-lg bg-[#14b8a6]/10 flex items-center justify-center mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-[1.125rem] h-[1.125rem] text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-semibold text-gray-100 mb-1.5">Edit in seconds</h3>
                        <p class="text-sm text-gray-500 leading-relaxed">Add, move, or remove events instantly — no extra steps.</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="border-t border-white/[0.06]">
            <div class="max-w-3xl mx-auto px-6 py-20 text-center">
                <h2 class="text-2xl font-semibold tracking-tight text-gray-50">Ready to get organized?</h2>
                <p class="mt-2 text-sm text-gray-500">Create a free account and build your first schedule in minutes.</p>
                <a href="/register" class="inline-block mt-6 px-5 py-2.5 rounded-lg text-sm font-semibold bg-[#14b8a6] hover:bg-[#2dd4bf] text-[#04211d] transition-colors">
                    Get started free
                </a>
            </div>
        </section>
    </main>

    <footer class="border-t border-white/[0.06]">
        <div class="max-w-6xl mx-auto px-6 py-8 flex items-center justify-between text-xs text-gray-600">
            <span>© @DateTime.Now.Year Schedly</span>
            <div class="flex items-center gap-4">
                <a href="/login" class="hover:text-gray-400 transition-colors">Sign in</a>
                <a href="/register" class="hover:text-gray-400 transition-colors">Register</a>
            </div>
        </div>
    </footer>
</div>
