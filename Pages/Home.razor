@page "/home"
@layout EmptyLayout
@inject NavigationManager Navigation

<div class="flex min-h-screen bg-[#0b0d11] text-gray-200 font-sans">
    <aside class="w-[240px] flex-shrink-0 bg-[#0e1013] border-r border-white/[0.06] p-6 flex flex-col">
        <div class="flex items-center gap-2.5 mb-10">
            <div class="w-7 h-7 rounded-lg bg-[#14b8a6]/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#2dd4bf]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div>
                <div class="text-gray-50 font-semibold tracking-tight text-sm leading-none">Schedly</div>
                <div class="text-gray-600 text-[0.68rem] mt-1">@TodayDate.ToString("yyyy-MM-dd")</div>
            </div>
        </div>

        <nav class="flex flex-col gap-0.5">
            <button class="flex items-center gap-3 px-3 py-2 border-0 text-left rounded-lg cursor-pointer text-sm transition-colors @(ActiveView == "today" ? "bg-[#14b8a6]/10 text-[#2dd4bf]" : "bg-transparent text-gray-500 hover:bg-white/[0.03] hover:text-gray-300")"
                    @onclick='() => ActiveView = "today"'>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /><path d="M8 14h.01M12 14h.01M16 14h.01" />
                </svg>
                Today
            </button>
            <button class="flex items-center gap-3 px-3 py-2 border-0 text-left rounded-lg cursor-pointer text-sm transition-colors @(ActiveView == "week" ? "bg-[#14b8a6]/10 text-[#2dd4bf]" : "bg-transparent text-gray-500 hover:bg-white/[0.03] hover:text-gray-300")"
                    @onclick='() => ActiveView = "week"'>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
                Week
            </button>
            <button class="flex items-center gap-3 px-3 py-2 border-0 text-left rounded-lg cursor-pointer text-sm transition-colors @(ActiveView == "events" ? "bg-[#14b8a6]/10 text-[#2dd4bf]" : "bg-transparent text-gray-500 hover:bg-white/[0.03] hover:text-gray-300")"
                    @onclick='() => ActiveView = "events"'>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" />
                </svg>
                Events
            </button>
        </nav>
    </aside>

    <div class="fixed bottom-0 left-0 w-[240px] bg-[#0e1013] border-r border-t border-white/[0.06] p-6 z-20">
        <LiveClock />
        <button class="mt-4 w-full flex items-center gap-2 px-3 py-2 rounded-lg bg-transparent text-gray-500 cursor-pointer text-sm text-left transition-colors hover:bg-rose-500/10 hover:text-rose-400"
                @onclick="SignOut">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sign out
        </button>
    </div>

    <main class="flex-1 p-8 lg:p-10 overflow-x-auto">

        @if (ActiveView == "today")
        {
            var todays = Events.Where(e => e.Date == TodayDate).OrderBy(e => e.Start).ToList();

            <div class="flex justify-between items-start mb-8">
                <div>
                    <h1 class="m-0 text-2xl font-semibold tracking-tight text-gray-50">Today</h1>
                    <span class="text-gray-500 text-sm">@TodayDate.ToString("MMM d, yyyy")</span>
                </div>
                <div class="text-gray-500 text-sm bg-white/[0.03] border border-white/[0.06] rounded-full px-3 py-1">@todays.Count events</div>
            </div>

            <div class="relative border-t border-white/[0.06] ml-[52px]">
                @foreach (var hour in TimelineHours)
                {
                    <div class="absolute -left-[52px] right-0 h-16 border-t border-white/[0.06]" style="top:@(RowTop(hour))px;">
                        <span class="absolute left-0 -top-2 w-11 text-[0.7rem] text-gray-600 text-right">@hour.ToString("00"):00</span>
                    </div>
                }

                @if (ShowNowLine)
                {
                    <div class="absolute left-0 right-0 h-px bg-rose-500 z-10 flex items-center" style="top:@(NowLineTop())px;">
                        <div class="w-1.5 h-1.5 rounded-full bg-rose-500 -ml-0.75"></div>
                    </div>
                }

                @foreach (var ev in todays)
                {
                    var durationMins = (ev.End.ToTimeSpan() - ev.Start.ToTimeSpan()).TotalMinutes;
                    var compact = durationMins < 30;
                    <div class="absolute left-1 right-1 rounded-lg border-l-2 overflow-hidden text-[0.8rem] @CategoryBlock(ev.Category) @(compact ? "px-3 py-1.5 flex items-center" : "px-3.5 py-2.5")"
                         style="top:@(EventTop(ev))px; height:@(EventHeight(ev))px;">
                        <div class="flex justify-between items-baseline gap-2 @(compact ? "w-full" : "")">
                            <span class="font-medium text-gray-100 truncate">@ev.Title</span>
                            <span class="text-[0.68rem] text-gray-500 shrink-0">@FormatDuration(ev)</span>
                        </div>
                        @if (durationMins >= 30)
                        {
                            <div class="text-[0.7rem] text-gray-500 mt-0.5">@ev.Start.ToString("HH:mm") – @ev.End.ToString("HH:mm")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ev.Notes) && durationMins >= 45)
                        {
                            <div class="text-[0.72rem] text-gray-500 mt-1 truncate">@ev.Notes</div>
                        }
                    </div>
                }
            </div>
        }
        else if (ActiveView == "week")
        {
            <div class="flex justify-between items-start mb-8">
                <div>
                    <h1 class="m-0 text-2xl font-semibold tracking-tight text-gray-50">Week</h1>
                    <span class="text-gray-500 text-sm">@WeekStart.ToString("MMM d") – @WeekStart.AddDays(6).ToString("MMM d, yyyy")</span>
                </div>
                <div class="flex gap-1.5">
                    <button class="bg-white/[0.03] border border-white/[0.06] text-gray-400 hover:text-gray-200 hover:bg-white/[0.06] px-3 py-1.5 rounded-lg cursor-pointer text-[0.8rem] transition-colors" @onclick="() => WeekOffset--">←</button>
                    <button class="bg-[#14b8a6]/10 border border-[#14b8a6]/30 text-[#2dd4bf] hover:bg-[#14b8a6]/20 px-3 py-1.5 rounded-lg cursor-pointer text-[0.8rem] transition-colors" @onclick="() => WeekOffset = 0">Today</button>
                    <button class="bg-white/[0.03] border border-white/[0.06] text-gray-400 hover:text-gray-200 hover:bg-white/[0.06] px-3 py-1.5 rounded-lg cursor-pointer text-[0.8rem] transition-colors" @onclick="() => WeekOffset++">→</button>
                </div>
            </div>

            <div class="grid grid-cols-7 gap-px bg-white/[0.06] border border-white/[0.06] rounded-xl overflow-hidden">
                @for (int d = 0; d < 7; d++)
                {
                    var day = WeekStart.AddDays(d);
                    var isToday = day == TodayDate;
                    <div class="bg-[#0e1013] p-3 text-center">
                        <span class="block text-[0.68rem] text-gray-600 tracking-wide mb-1">@day.ToString("ddd").ToUpper()</span>
                        @if (isToday)
                        {
                            <span class="inline-flex items-center justify-center w-6 h-6 text-sm font-semibold bg-[#2dd4bf] text-[#04211d] rounded-full">@day.Day</span>
                        }
                        else
                        {
                            <span class="block text-sm font-medium text-gray-400">@day.Day</span>
                        }
                    </div>
                }

                @for (int d = 0; d < 7; d++)
                {
                    var day = WeekStart.AddDays(d);
                    var dayEvents = Events.Where(e => e.Date == day).ToList();
                    <div class="relative bg-[#0b0d11]" style="height:832px;">
                        @foreach (var hour in TimelineHours)
                        {
                            <div class="absolute left-0 right-0 border-t border-white/[0.04]" style="top:@(RowTop(hour))px;"></div>
                        }
                        @foreach (var ev in dayEvents)
                        {
                            <div class="absolute left-0.5 right-0.5 rounded-md border-l-2 overflow-hidden px-1.5 py-1 text-[0.68rem] @CategoryBlock(ev.Category)"
                                 style="top:@(EventTop(ev))px; height:@(EventHeight(ev))px;">
                                <div class="font-medium text-gray-100 text-[0.7rem] truncate">@ev.Title</div>
                                <div class="text-[0.65rem] text-gray-500">@ev.Start.ToString("HH:mm")</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mb-8">
                <h1 class="m-0 text-2xl font-semibold tracking-tight text-gray-50">Events</h1>
            </div>

            <div class="flex flex-col lg:flex-row gap-6 items-start">
                <div class="w-full lg:w-[300px] flex-shrink-0 bg-[#0e1013] border border-white/[0.06] rounded-xl p-5">
                    <h3 class="mt-0 mb-5 text-[0.95rem] font-semibold text-gray-100">@(EditingEvent is null ? "New Event" : "Edit Event")</h3>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-[0.7rem] font-medium text-gray-500 mb-1.5">Title</label>
                            <input class="w-full bg-white/[0.03] border border-white/[0.08] text-gray-100 px-3 py-2 rounded-lg text-[0.85rem] outline-none focus:border-[#2dd4bf]/50 transition-colors placeholder:text-gray-600"
                                   placeholder="Event title" @bind="NewTitle" />
                        </div>

                        <div>
                            <label class="block text-[0.7rem] font-medium text-gray-500 mb-1.5">Date</label>
                            <input class="w-full bg-white/[0.03] border border-white/[0.08] text-gray-100 px-3 py-2 rounded-lg text-[0.85rem] outline-none focus:border-[#2dd4bf]/50 transition-colors [&::-webkit-calendar-picker-indicator]:invert [&::-webkit-calendar-picker-indicator]:opacity-60 [&::-webkit-calendar-picker-indicator]:cursor-pointer"
                                   type="date" @bind="NewDate" />
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[0.7rem] font-medium text-gray-500 mb-1.5">Start</label>
                                <input class="w-full bg-white/[0.03] border border-white/[0.08] text-gray-100 px-3 py-2 rounded-lg text-[0.85rem] outline-none focus:border-[#2dd4bf]/50 transition-colors [&::-webkit-calendar-picker-indicator]:invert [&::-webkit-calendar-picker-indicator]:opacity-60 [&::-webkit-calendar-picker-indicator]:cursor-pointer"
                                       type="time" @bind="NewStart" />
                            </div>
                            <div>
                                <label class="block text-[0.7rem] font-medium text-gray-500 mb-1.5">End</label>
                                <input class="w-full bg-white/[0.03] border border-white/[0.08] text-gray-100 px-3 py-2 rounded-lg text-[0.85rem] outline-none focus:border-[#2dd4bf]/50 transition-colors [&::-webkit-calendar-picker-indicator]:invert [&::-webkit-calendar-picker-indicator]:opacity-60 [&::-webkit-calendar-picker-indicator]:cursor-pointer"
                                       type="time" @bind="NewEnd" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-[0.7rem] font-medium text-gray-500 mb-1.5">Category</label>
                            <div class="grid grid-cols-2 gap-2">
                                @foreach (var cat in Categories)
                                {
                                    <button class="px-2 py-1.5 rounded-lg border cursor-pointer text-[0.78rem] font-medium transition-colors @(NewCategory == cat ? CategoryButtonSelected(cat) : "border-white/[0.08] bg-white/[0.03] text-gray-500 hover:text-gray-300")"
                                            @onclick="() => NewCategory = cat">
                                        @cat
                                    </button>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="block text-[0.7rem] font-medium text-gray-500 mb-1.5">Notes (optional)</label>
                            <textarea class="w-full bg-white/[0.03] border border-white/[0.08] text-gray-100 px-3 py-2 rounded-lg text-[0.85rem] outline-none focus:border-[#2dd4bf]/50 transition-colors resize-y min-h-[60px] placeholder:text-gray-600"
                                      placeholder="Add notes..." @bind="NewNotes"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(FormError))
                    {
                        <div class="text-rose-400 text-[0.75rem] mt-3">@FormError</div>
                    }

                    <button class="w-full mt-5 py-2.5 rounded-lg border-0 bg-[#14b8a6] hover:bg-[#2dd4bf] text-[#04211d] text-sm font-semibold cursor-pointer transition-colors"
                            @onclick="SaveEvent">
                        @(EditingEvent is null ? "+ Add Event" : "Save Changes")
                    </button>
                    @if (EditingEvent is not null)
                    {
                        <button class="w-full mt-2 py-2 rounded-lg border border-white/[0.08] bg-transparent text-gray-500 text-sm cursor-pointer hover:text-gray-300 hover:border-white/20 transition-colors"
                                @onclick="CancelEdit">
                            Cancel
                        </button>
                    }
                </div>

                <div class="flex-1 min-w-0 w-full">
                    <div class="flex items-center gap-2 mb-5 flex-wrap">
                        @foreach (var f in new[] { "All", "Work", "Personal", "Health", "Focus" })
                        {
                            <button class="px-3.5 py-1.5 rounded-full border cursor-pointer text-[0.78rem] font-medium transition-colors @(SelectedFilter == f ? "bg-[#14b8a6] text-[#04211d] border-[#14b8a6]" : "border-white/[0.08] bg-white/[0.03] text-gray-500 hover:text-gray-300")"
                                    @onclick="() => SelectedFilter = f">
                                @f
                            </button>
                        }
                        <span class="ml-auto text-gray-600 text-[0.78rem]">@FilteredEvents.Count() records</span>
                    </div>

                    @foreach (var group in FilteredEvents.GroupBy(e => e.Date).OrderBy(g => g.Key))
                    {
                        <div class="flex items-baseline gap-2.5 mt-6 mb-2.5 text-gray-600 text-[0.75rem]">
                            <span class="font-medium">@group.Key.ToString("MMM d, yyyy")</span>
                            @if (group.Key == TodayDate)
                            {
                                <span class="bg-[#14b8a6]/10 text-[#2dd4bf] rounded-full px-2 py-0.5 text-[0.65rem] font-medium">TODAY</span>
                            }
                        </div>

                        <div class="space-y-2">
                            @foreach (var ev in group.OrderBy(e => e.Start))
                            {
                                <div class="flex items-center gap-4 bg-[#0e1013] border border-white/[0.06] rounded-lg px-4 py-3 hover:border-white/[0.12] transition-colors group">
                                    <div class="w-[100px] flex-shrink-0 text-[0.78rem] text-gray-500 font-mono">@ev.Start.ToString("HH:mm")–@ev.End.ToString("HH:mm")</div>
                                    <div class="flex-1 min-w-0">
                                        <div class="font-medium text-[0.88rem] text-gray-100 truncate">@ev.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(ev.Notes))
                                        {
                                            <div class="text-[0.75rem] text-gray-500 truncate">@ev.Notes</div>
                                        }
                                    </div>
                                    <span class="text-[0.68rem] font-medium px-2 py-0.5 rounded-full flex-shrink-0 @CategoryBadge(ev.Category)">@ev.Category</span>
                                    <span class="w-[46px] text-right flex-shrink-0 text-[0.75rem] text-gray-500">@FormatDuration(ev)</span>
                                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button class="p-1.5 rounded-md bg-transparent border-0 text-gray-500 cursor-pointer hover:text-[#2dd4bf] hover:bg-white/[0.06]" @onclick="() => StartEdit(ev)">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                            </svg>
                                        </button>
                                        <button class="p-1.5 rounded-md bg-transparent border-0 text-gray-500 cursor-pointer hover:text-rose-400 hover:bg-white/[0.06]" @onclick="() => RemoveEvent(ev)">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </main>
</div>

@code {
    private string ActiveView = "today";
    private string SelectedFilter = "All";
    private int WeekOffset = 0;

    private readonly DateOnly TodayDate = DateOnly.FromDateTime(DateTime.Now);
    private readonly int[] TimelineHours = Enumerable.Range(7, 13).ToArray(); // 07:00 -> 19:00
    private const double PxPerHour = 64;

    private readonly string[] Categories = { "Work", "Personal", "Health", "Focus" };

    private DateOnly WeekStart =>
        TodayDate.AddDays(-(int)TodayDate.DayOfWeek + (TodayDate.DayOfWeek == DayOfWeek.Sunday ? -6 : 1))
                 .AddDays(WeekOffset * 7);

    private class ScheduleEvent
    {
        public string Title { get; set; } = "";
        public DateOnly Date { get; set; }
        public TimeOnly Start { get; set; }
        public TimeOnly End { get; set; }
        public string Category { get; set; } = "Work";
        public string? Notes { get; set; }
    }

    private List<ScheduleEvent> Events = new();

    private IEnumerable<ScheduleEvent> FilteredEvents =>
        SelectedFilter == "All" ? Events : Events.Where(e => e.Category == SelectedFilter);

    // new-event / edit form state
    private string NewTitle = "";
    private DateOnly? NewDate;
    private TimeOnly? NewStart;
    private TimeOnly? NewEnd;
    private string NewCategory = "Work";
    private string? NewNotes;
    private string? FormError;
    private ScheduleEvent? EditingEvent;

    protected override void OnInitialized()
    {
        ResetForm();
        SeedEvents();
    }

    private void SeedEvents()
    {
        var mon = WeekStart;
        Events = new List<ScheduleEvent>
        {
            new() { Title = "Client call", Date = mon.AddDays(2), Start = new(11,0), End = new(11,45), Category = "Work" },
            new() { Title = "Morning standup", Date = mon.AddDays(3), Start = new(9,0), End = new(9,15), Category = "Work", Notes = "Sprint sync — review blockers" },
            new() { Title = "Deep work: auth module", Date = mon.AddDays(3), Start = new(9,30), End = new(12,0), Category = "Focus" },
            new() { Title = "Lunch", Date = mon.AddDays(3), Start = new(12,0), End = new(13,0), Category = "Personal" },
            new() { Title = "Code review session", Date = mon.AddDays(3), Start = new(13,0), End = new(14,0), Category = "Work", Notes = "PR #471 — pagination refactor" },
            new() { Title = "Team retrospective", Date = mon.AddDays(3), Start = new(15,0), End = new(16,0), Category = "Work" },
            new() { Title = "Gym", Date = mon.AddDays(3), Start = new(17,30), End = new(18,30), Category = "Health" },
            new() { Title = "Run: 5k", Date = mon.AddDays(4), Start = new(7,0), End = new(7,45), Category = "Health" },
            new() { Title = "Design review", Date = mon.AddDays(4), Start = new(10,0), End = new(11,0), Category = "Work" },
            new() { Title = "Architecture planning", Date = mon.AddDays(4), Start = new(14,0), End = new(16,0), Category = "Focus", Notes = "Database sharding proposal" },
            new() { Title = "Release deploy", Date = mon.AddDays(5), Start = new(9,0), End = new(10,0), Category = "Work" },
        };
    }

    private double RowTop(int hour) => (hour - TimelineHours[0]) * PxPerHour;

    private double EventTop(ScheduleEvent ev) =>
        (ev.Start.Hour - TimelineHours[0]) * PxPerHour + (ev.Start.Minute / 60.0) * PxPerHour;

    private double EventHeight(ScheduleEvent ev)
    {
        var minutes = (ev.End.ToTimeSpan() - ev.Start.ToTimeSpan()).TotalMinutes;
        return Math.Max(minutes / 60.0 * PxPerHour - 3, 26);
    }

    private bool ShowNowLine => DateTime.Now.Hour >= TimelineHours.First() && DateTime.Now.Hour <= TimelineHours.Last();

    private double NowLineTop()
    {
        var now = DateTime.Now;
        return (now.Hour - TimelineHours[0]) * PxPerHour + (now.Minute / 60.0) * PxPerHour;
    }

    private string FormatDuration(ScheduleEvent ev)
    {
        var mins = (int)(ev.End.ToTimeSpan() - ev.Start.ToTimeSpan()).TotalMinutes;
        if (mins < 60) return $"{mins}m";
        var h = mins / 60;
        var m = mins % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    // Tailwind class helpers per category (kept centralized so colors stay consistent)
    private static string CategoryBlock(string cat) => cat switch
    {
        "Work" => "border-blue-500 bg-blue-500/[0.07]",
        "Personal" => "border-green-500 bg-green-500/[0.07]",
        "Health" => "border-pink-500 bg-pink-500/[0.07]",
        "Focus" => "border-violet-400 bg-violet-400/[0.07]",
        _ => "border-gray-500 bg-gray-500/[0.07]"
    };

    private static string CategoryBadge(string cat) => cat switch
    {
        "Work" => "bg-blue-500/15 text-blue-300",
        "Personal" => "bg-green-500/15 text-green-300",
        "Health" => "bg-pink-500/15 text-pink-300",
        "Focus" => "bg-violet-400/20 text-violet-200",
        _ => "bg-gray-500/15 text-gray-300"
    };

    private static string CategoryButtonSelected(string cat) => cat switch
    {
        "Work" => "border-blue-500/60 bg-blue-500/10 text-blue-300",
        "Personal" => "border-green-500/60 bg-green-500/10 text-green-300",
        "Health" => "border-pink-500/60 bg-pink-500/10 text-pink-300",
        "Focus" => "border-violet-400/60 bg-violet-400/10 text-violet-200",
        _ => "border-gray-500/60 bg-gray-500/10 text-gray-300"
    };

    private void StartEdit(ScheduleEvent ev)
    {
        EditingEvent = ev;
        NewTitle = ev.Title;
        NewDate = ev.Date;
        NewStart = ev.Start;
        NewEnd = ev.End;
        NewCategory = ev.Category;
        NewNotes = ev.Notes;
        FormError = null;
        ActiveView = "events";
    }

    private void CancelEdit()
    {
        EditingEvent = null;
        ResetForm();
    }

    private void RemoveEvent(ScheduleEvent ev)
    {
        Events.Remove(ev);
        if (EditingEvent == ev)
        {
            EditingEvent = null;
            ResetForm();
        }
    }

    private void SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(NewTitle) || NewDate is null || NewStart is null || NewEnd is null)
        {
            FormError = "Title, date, start and end are required.";
            return;
        }

        if (NewEnd <= NewStart)
        {
            FormError = "End time must be after start time.";
            return;
        }

        if (EditingEvent is not null)
        {
            EditingEvent.Title = NewTitle;
            EditingEvent.Date = NewDate.Value;
            EditingEvent.Start = NewStart.Value;
            EditingEvent.End = NewEnd.Value;
            EditingEvent.Category = NewCategory;
            EditingEvent.Notes = NewNotes;
            EditingEvent = null;
        }
        else
        {
            Events.Add(new ScheduleEvent
            {
                Title = NewTitle,
                Date = NewDate.Value,
                Start = NewStart.Value,
                End = NewEnd.Value,
                Category = NewCategory,
                Notes = NewNotes
            });
        }

        FormError = null;
        ResetForm();
    }

    private void SignOut()
    {
        // TODO: clear auth/session state once backend auth exists
        Navigation.NavigateTo("/login");
    }

    private void ResetForm()
    {
        NewTitle = "";
        NewNotes = null;
        NewStart = null;
        NewEnd = null;
        NewCategory = "Work";
        NewDate = TodayDate;
    }
}
