@* Shared split-panel layout used by Register.razor and Login.razor *@

<div class="flex min-h-screen font-sans bg-[#0b0d11]">
    <div class="flex-1 flex flex-col p-8 sm:p-12 lg:p-16">
        <a href="/" class="flex items-center gap-2.5 mb-12 w-fit">
            <div class="w-8 h-8 rounded-lg bg-[#14b8a6]/10 flex items-center justify-center">
                <img src="images/citcreds-logo.svg" alt="Schedly" class="h-5 w-5" />
            </div>
            <span class="font-semibold tracking-tight text-[#2dd4bf]">Schedly</span>
        </a>

        <div class="flex-1 flex items-center">
            <div class="w-full max-w-[360px]">
                @ChildContent
            </div>
        </div>
    </div>

    <div class="hidden md:flex flex-1 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-[#14b8a6] to-[#0b3b36]"></div>
        <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 22px 22px;"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute bottom-0 -left-24 w-80 h-80 rounded-full bg-black/20 blur-3xl"></div>
        <div class="relative flex flex-col justify-end p-16 text-white w-full">
            <h1 class="text-[2rem] leading-tight font-semibold tracking-tight mb-2">@RightTitle</h1>
            <p class="text-white/70 text-[0.95rem]">@RightSubtitle</p>

            @if (Features is { Count: > 0 })
            {
                <ul class="mt-7 space-y-3">
                    @foreach (var feature in Features)
                    {
                        <li class="flex items-center gap-2.5 text-sm text-white/80">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                            @feature
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string RightTitle { get; set; } = "";
    [Parameter] public string RightSubtitle { get; set; } = "Lorem Ipsum is simply";
    [Parameter] public List<string>? Features { get; set; }
}
